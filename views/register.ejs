<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account — VaultixPOS</title>

  <%# ── CDN Dependencies ── %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ════ Design Tokens ════ */
    :root {
      --brand:        #4F70E8;
      --brand-dark:   #3655C5;
      --brand-glow:   rgba(79, 112, 232, 0.26);
      --amber:        #F5A623;
      --amber-glow:   rgba(245, 166, 35, 0.22);
      --emerald:      #0ECB81;
      --rose:         #F43F5E;
      --bg:           #070E1C;
      --bg-surface:   #0C1625;
      --bg-input:     #0D1827;
      --border:       #192B42;
      --text-primary: #EEF2FF;
      --text-sec:     #8FA3BF;
      --text-muted:   #4A6080;
      --radius:       12px;
      --radius-sm:    8px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* ── Ambient blobs ── */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(110px);
      pointer-events: none;
      z-index: 0;
    }
    .orb-brand  { width: 400px; height: 400px; background: radial-gradient(circle, rgba(79,112,232,0.14), transparent 65%); top: -100px;   right: -80px; }
    .orb-amber  { width: 380px; height: 380px; background: radial-gradient(circle, rgba(245,166,35,0.11), transparent 65%); bottom: -80px;  left: -80px;  }

    /* ── Layout ── */
    .auth-wrapper {
      min-height: 100vh;
      display: flex;
      position: relative;
      z-index: 1;
    }

    /* ── Brand Panel ── */
    .brand-panel {
      width: 44%;
      min-height: 100vh;
      background: linear-gradient(155deg, #0A1524 0%, #0E1E36 55%, #07101C 100%);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 2.75rem 3rem;
      position: relative;
      overflow: hidden;
    }
    .brand-panel::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 70% 40%, rgba(245,166,35,0.07) 0%, transparent 55%);
      pointer-events: none;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      z-index: 1;
    }
    .brand-mark {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--brand) 0%, #2C3FA0 100%);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; color: #fff;
      box-shadow: 0 0 18px var(--brand-glow);
      flex-shrink: 0;
    }
    .brand-type {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--text-primary);
    }
    .brand-type em { font-style: normal; color: var(--brand); }

    .brand-hero {
      position: relative;
      z-index: 1;
    }
    .brand-hero h2 {
      font-size: 2.1rem;
      font-weight: 800;
      line-height: 1.22;
      letter-spacing: -0.7px;
      color: var(--text-primary);
      margin-bottom: 1rem;
    }
    .brand-hero h2 .grad {
      background: linear-gradient(90deg, var(--amber) 0%, #FFCB6B 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .brand-hero p {
      font-size: 0.88rem;
      color: var(--text-sec);
      line-height: 1.78;
      max-width: 290px;
    }

    /* Steps list */
    .brand-steps {
      position: relative;
      z-index: 1;
      list-style: none;
      padding: 0; margin: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .bs-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .bs-num {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: rgba(79, 112, 232, 0.12);
      border: 1px solid rgba(79, 112, 232, 0.3);
      color: #93ADFF;
      font-size: 0.72rem;
      font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .bs-text strong {
      display: block;
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 1px;
    }
    .bs-text span {
      font-size: 0.77rem;
      color: var(--text-sec);
    }

    /* ── Form Panel ── */
    .form-panel {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 2rem;
    }

    .form-card {
      width: 100%;
      max-width: 420px;
    }
    .form-card h1 {
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 5px;
    }
    .form-sub {
      font-size: 0.875rem;
      color: var(--text-sec);
      margin-bottom: 2rem;
    }
    .form-sub a {
      color: var(--brand);
      text-decoration: none;
      font-weight: 500;
    }
    .form-sub a:hover { text-decoration: underline; }

    /* Two-column row */
    .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 14px;
    }

    /* ── Field ── */
    .field { margin-bottom: 1.05rem; }
    .field label {
      display: block;
      font-size: 0.77rem;
      font-weight: 600;
      color: var(--text-sec);
      text-transform: uppercase;
      letter-spacing: 0.45px;
      margin-bottom: 7px;
    }
    .field-wrap { position: relative; }
    .field-wrap input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 11px 40px 11px 14px;
      font-size: 0.88rem;
      font-family: 'Inter', sans-serif;
      color: var(--text-primary);
      outline: none;
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    .field-wrap input::placeholder { color: var(--text-muted); }
    .field-wrap input:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px var(--brand-glow);
    }
    .f-icon {
      position: absolute;
      top: 50%; right: 12px;
      transform: translateY(-50%);
      font-size: 14px;
      color: var(--text-muted);
      pointer-events: none;
      transition: color 0.18s;
    }
    .field-wrap input:focus ~ .f-icon { color: var(--brand); }
    .pw-toggle {
      position: absolute;
      top: 50%; right: 10px;
      transform: translateY(-50%);
      background: none; border: none;
      color: var(--text-muted);
      font-size: 14px; cursor: pointer;
      padding: 4px; display: flex; align-items: center;
      transition: color 0.18s;
    }
    .pw-toggle:hover { color: var(--text-sec); }
    .pw-toggle:focus-visible { outline: 2px solid var(--brand); border-radius: 4px; }

    /* Password strength meter */
    .pw-strength {
      margin-top: 6px;
      height: 3px;
      border-radius: 3px;
      background: var(--border);
      overflow: hidden;
    }
    .pw-strength-bar {
      height: 100%;
      border-radius: 3px;
      width: 0%;
      transition: width 0.3s, background 0.3s;
    }
    .pw-hint {
      font-size: 0.72rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* ── Submit Button ── */
    .btn-submit {
      width: 100%;
      padding: 12px 20px;
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      color: #fff;
      cursor: pointer;
      transition: transform 0.14s, box-shadow 0.2s;
      display: flex; align-items: center; justify-content: center;
      gap: 8px;
      margin-top: 0.5rem;
      letter-spacing: 0.1px;
    }
    .btn-submit:hover:not(:disabled) {
      box-shadow: 0 6px 22px rgba(79, 112, 232, 0.38);
      transform: translateY(-1px);
    }
    .btn-submit:active:not(:disabled) { transform: scale(0.975); }
    .btn-submit:disabled { opacity: 0.55; cursor: not-allowed; }
    .spin-ring {
      display: none;
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .terms-note {
      font-size: 0.76rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.9rem;
      line-height: 1.5;
    }

    /* ── Toast System ── */
    #toastShelf {
      position: fixed;
      bottom: 1.25rem; right: 1.25rem;
      z-index: 9900;
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: min(360px, calc(100vw - 2.5rem));
    }
    .toast-card {
      position: relative; overflow: hidden;
      display: flex; align-items: flex-start;
      gap: 10px; padding: 12px 14px;
      border-radius: var(--radius-sm);
      background: #0F1D30;
      border: 1px solid var(--border);
      box-shadow: 0 12px 40px rgba(0,0,0,0.55);
    }
    .tc-bar { position: absolute; top: 0; left: 0; width: 3px; height: 100%; border-radius: 8px 0 0 8px; }
    .tc-success .tc-bar { background: var(--emerald); }
    .tc-error   .tc-bar { background: var(--rose);    }
    .tc-info    .tc-bar { background: var(--brand);   }
    .tc-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
    .tc-success .tc-icon { color: var(--emerald); }
    .tc-error   .tc-icon { color: var(--rose);    }
    .tc-info    .tc-icon { color: #93ADFF;         }
    .tc-body { flex: 1; min-width: 0; }
    .tc-title { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); }
    .tc-msg   { font-size: 0.78rem; color: var(--text-sec); margin-top: 2px; line-height: 1.45; }
    .tc-close {
      background: none; border: none;
      color: var(--text-muted); font-size: 13px;
      cursor: pointer; padding: 2px;
      display: flex; align-items: center;
      transition: color 0.15s; flex-shrink: 0;
    }
    .tc-close:hover { color: var(--text-sec); }

    /* ── Responsive ── */
    @media (max-width: 900px) { .brand-panel { display: none !important; } }
    @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>

  <%# Ambient blobs %>
  <div class="orb orb-brand" aria-hidden="true"></div>
  <div class="orb orb-amber"  aria-hidden="true"></div>

  <%# Toast shelf %>
  <div id="toastShelf" role="log" aria-live="polite" aria-label="Notifications"></div>

  <div class="auth-wrapper">

    <%# ── Brand Panel (Left) ── %>
    <aside class="brand-panel d-none d-lg-flex flex-column" aria-hidden="true">
      <div class="brand-logo">
        <div class="brand-mark"><i class="bi bi-lightning-charge-fill"></i></div>
        <span class="brand-type">Vault<em>ix</em>POS</span>
      </div>

      <div class="brand-hero">
        <h2>Start selling in<br /><span class="grad">under 3 minutes.</span></h2>
        <p>Register your store and get instant access to your dashboard. No credit card required — your first 30 days are on us.</p>
      </div>

      <ol class="brand-steps">
        <li class="bs-item" id="step1">
          <span class="bs-num">1</span>
          <div class="bs-text">
            <strong>Create your store</strong>
            <span>Fill in your store details below.</span>
          </div>
        </li>
        <li class="bs-item" id="step2">
          <span class="bs-num">2</span>
          <div class="bs-text">
            <strong>Add your products</strong>
            <span>Import or manually add your inventory.</span>
          </div>
        </li>
        <li class="bs-item" id="step3">
          <span class="bs-num">3</span>
          <div class="bs-text">
            <strong>Start recording sales</strong>
            <span>Your dashboard goes live immediately.</span>
          </div>
        </li>
      </ol>
    </aside>

    <%# ── Form Panel (Right) ── %>
    <main class="form-panel">
      <div class="form-card" id="registerCard">

        <h1>Create your store</h1>
        <p class="form-sub">
          30-day free trial, no card needed &nbsp;·&nbsp;
          <a href="/login">Sign in instead →</a>
        </p>

        <form id="registerForm" novalidate autocomplete="on">

          <%# Store Name %>
          <div class="field">
            <label for="storeName">Store name</label>
            <div class="field-wrap">
              <input
                type="text" id="storeName" name="storeName"
                placeholder="e.g. Al-Nour Superstore"
                autocomplete="organization" required
              />
              <i class="bi bi-shop f-icon" aria-hidden="true"></i>
            </div>
          </div>

          <%# Email + Phone in a row %>
          <div class="field-row">
            <div class="field">
              <label for="email">Email address</label>
              <div class="field-wrap">
                <input
                  type="email" id="email" name="email"
                  placeholder="you@store.com"
                  autocomplete="email" required
                />
                <i class="bi bi-envelope f-icon" aria-hidden="true"></i>
              </div>
            </div>
            <div class="field">
              <label for="phone">Phone number</label>
              <div class="field-wrap">
                <input
                  type="tel" id="phone" name="phone"
                  placeholder="+1 555 000 0000"
                  autocomplete="tel" dir="ltr"
                />
                <i class="bi bi-telephone f-icon" aria-hidden="true"></i>
              </div>
            </div>
          </div>

          <%# Password %>
          <div class="field">
            <label for="password">Password</label>
            <div class="field-wrap">
              <input
                type="password" id="password" name="password"
                placeholder="Create a strong password"
                autocomplete="new-password" required
              />
              <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password">
                <i class="bi bi-eye" id="pwIcon"></i>
              </button>
            </div>
            <div class="pw-strength" role="progressbar" aria-label="Password strength" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
              <div class="pw-strength-bar" id="pwBar"></div>
            </div>
            <p class="pw-hint" id="pwHint">Use 8+ characters with letters and numbers.</p>
          </div>

          <%# Submit %>
          <button type="submit" class="btn-submit" id="registerBtn">
            <span class="spin-ring"  id="regSpinner"></span>
            <span id="regBtnText">
              <i class="bi bi-rocket-takeoff me-1" aria-hidden="true"></i>
              Create My Store
            </span>
          </button>

        
        </form>

      </div><%# /form-card %>
    </main>

  </div><%# /auth-wrapper %>

  <%# ── Scripts ── %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

  <script>
    /* ════════════════════════════════════════
       PAGE ENTRANCE ANIMATION
    ════════════════════════════════════════ */
    gsap.set(['#registerCard', '.brand-logo', '.brand-hero', '.bs-item'], { opacity: 0 });
    gsap.set('#registerCard',  { y: 28 });
    gsap.set('.brand-hero',    { y: 14 });

    const enterTL = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.1 });
    enterTL
      .to('.brand-logo',  { opacity: 1, duration: 0.5 })
      .to('.brand-hero',  { opacity: 1, y: 0, duration: 0.6 }, '-=0.3')
      .to('.bs-item',     { opacity: 1, y: 0, stagger: 0.1, duration: 0.35 }, '-=0.3')
      .to('#registerCard',{ opacity: 1, y: 0, duration: 0.55 }, '-=0.5');

    /* ════════════════════════════════════════
       TOAST SYSTEM
    ════════════════════════════════════════ */
    const TC_CFG = {
      success: { icon: 'bi-check-circle-fill', title: 'Success', cls: 'tc-success' },
      error:   { icon: 'bi-x-circle-fill',     title: 'Error',   cls: 'tc-error'   },
      info:    { icon: 'bi-info-circle-fill',   title: 'Note',    cls: 'tc-info'    },
    };

    function showToast(message, type = 'info') {
      const cfg   = TC_CFG[type] || TC_CFG.info;
      const shelf = document.getElementById('toastShelf');
      const el    = document.createElement('div');

      el.className = `toast-card ${cfg.cls}`;
      el.innerHTML = `
        <span class="tc-bar" aria-hidden="true"></span>
        <i class="bi ${cfg.icon} tc-icon" aria-hidden="true"></i>
        <div class="tc-body">
          <div class="tc-title">${cfg.title}</div>
          <div class="tc-msg">${message}</div>
        </div>
        <button class="tc-close" aria-label="Dismiss">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      `;
      shelf.appendChild(el);

      gsap.fromTo(el,
        { opacity: 0, x: 55, scale: 0.93 },
        { opacity: 1, x: 0,  scale: 1, duration: 0.32, ease: 'back.out(1.6)' }
      );

      const dismiss = () => {
        gsap.to(el, {
          opacity: 0, x: 55, scale: 0.93, duration: 0.22, ease: 'power2.in',
          onComplete: () => el.remove(),
        });
      };
      const timer = setTimeout(dismiss, 4500);
      el.querySelector('.tc-close').addEventListener('click', () => {
        clearTimeout(timer);
        dismiss();
      });
    }

    /* ════════════════════════════════════════
       PASSWORD STRENGTH METER
    ════════════════════════════════════════ */
    const STRENGTH_COLORS = ['#F43F5E', '#F59E0B', '#3B82F6', '#0ECB81'];
    const STRENGTH_HINTS  = [
      'Too weak — try a longer password.',
      'Needs more: add numbers or symbols.',
      'Getting there — almost strong enough.',
      'Strong password!',
    ];

    function calcStrength(pw) {
      let score = 0;
      if (pw.length >= 8)                   score++;
      if (pw.length >= 12)                  score++;
      if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
      if (/\d/.test(pw))                    score++;
      if (/[^A-Za-z0-9]/.test(pw))         score++;
      return Math.min(Math.floor((score / 5) * 4), 3);
    }

    document.getElementById('password').addEventListener('input', function () {
      const val    = this.value;
      const bar    = document.getElementById('pwBar');
      const hint   = document.getElementById('pwHint');
      const prog   = document.querySelector('.pw-strength');

      if (!val) {
        bar.style.width      = '0%';
        hint.textContent     = 'Use 8+ characters with letters and numbers.';
        prog.setAttribute('aria-valuenow', 0);
        return;
      }
      const lvl            = calcStrength(val);
      const pct            = ((lvl + 1) / 4) * 100;
      bar.style.width      = pct + '%';
      bar.style.background = STRENGTH_COLORS[lvl];
      hint.textContent     = STRENGTH_HINTS[lvl];
      hint.style.color     = STRENGTH_COLORS[lvl];
      prog.setAttribute('aria-valuenow', pct);
    });

    /* ════════════════════════════════════════
       PASSWORD TOGGLE
    ════════════════════════════════════════ */
    document.getElementById('pwToggle').addEventListener('click', function () {
      const input = document.getElementById('password');
      const icon  = document.getElementById('pwIcon');
      const show  = input.type === 'password';
      input.type  = show ? 'text' : 'password';
      icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
      this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });

    /* ════════════════════════════════════════
       INPUT MICRO-INTERACTIONS
    ════════════════════════════════════════ */
    document.querySelectorAll('.field-wrap input').forEach(input => {
      input.addEventListener('focus', () => gsap.to(input, { scale: 1.005, duration: 0.12, ease: 'power1.out' }));
      input.addEventListener('blur',  () => gsap.to(input, { scale: 1,     duration: 0.12, ease: 'power1.out' }));
    });

    /* ════════════════════════════════════════
       SHAKE HELPER
    ════════════════════════════════════════ */
    function shakeCard() {
      gsap.to('#registerCard', {
        keyframes: { x: [0, -9, 9, -7, 7, -4, 4, 0] },
        duration: 0.5, ease: 'none',
      });
    }

    /* ════════════════════════════════════════
       FORM SUBMISSION
    ════════════════════════════════════════ */
    document.getElementById('registerForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const storeName = document.getElementById('storeName').value.trim();
      const email     = document.getElementById('email').value.trim();
      const password  = document.getElementById('password').value;
      const phone     = document.getElementById('phone').value.trim();

      /* Client-side validation */
      if (!storeName || !email || !password) {
        showToast('Store name, email, and password are required.', 'error');
        shakeCard();
        return;
      }
      if (password.length < 8) {
        showToast('Password must be at least 8 characters long.', 'error');
        shakeCard();
        return;
      }
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRe.test(email)) {
        showToast('Please enter a valid email address.', 'error');
        shakeCard();
        return;
      }

      /* Loading state */
      const btn     = document.getElementById('registerBtn');
      const spinner = document.getElementById('regSpinner');
      const btnText = document.getElementById('regBtnText');

      btn.disabled          = true;
      spinner.style.display = 'block';
      btnText.style.display = 'none';
      gsap.to(btn, { scale: 0.97, duration: 0.1 });

      try {
        const res = await fetch('/register', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify({ storeName, email, password, phone }),
          signal:  AbortSignal.timeout(15000),
        });

        let data;
        try {
          data = await res.json();
        } catch {
          throw new Error('The server returned an unexpected response. Please try again.');
        }

        if (res.ok && data.success) {
          showToast(data.message || 'Store created! Redirecting to your dashboard…', 'success');

          /* Animate brand steps to highlight completion */
          ['#step1', '#step2', '#step3'].forEach((id, i) => {
            gsap.to(id, {
              color: '#0ECB81',
              delay: i * 0.15,
              duration: 0.3,
            });
          });

          gsap.to('#registerCard', {
            opacity: 0, scale: 0.96, y: -10, duration: 0.38, ease: 'power2.in', delay: 0.7,
            onComplete: () => { window.location.href = data.redirect || '/dashboard'; },
          });
        } else {
          showToast(data.message || 'Registration failed. Please check your details.', 'error');
          shakeCard();
        }

      } catch (err) {
        const msg = err.name === 'TimeoutError'
          ? 'Request timed out. Check your connection and try again.'
          : (err.message || 'Connection error. Please try again.');
        showToast(msg, 'error');
      } finally {
        btn.disabled          = false;
        spinner.style.display = 'none';
        btnText.style.display = '';
        gsap.to(btn, { scale: 1, duration: 0.1 });
      }
    });
  </script>
</body>
</html>
