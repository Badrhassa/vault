<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Pending — VaultixPOS</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --brand: #4F70E8; --brand-glow: rgba(79,112,232,0.22);
      --amber: #F5A623; --amber-glow: rgba(245,166,35,0.28);
      --emerald: #0ECB81; --rose: #F43F5E;
      --bg: #060C18; --surface: #0B1525; --border: #172030;
      --text: #EEF2FF; --text-sec: #8FA3BF; --text-muted: #4A6080;
      --wa: #25D366; --wa-glow: rgba(37,211,102,0.35);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      min-height: 100vh; font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg); color: var(--text);
      display: flex; align-items: center; justify-content: center; padding: 2rem;
    }

    .orb { position: fixed; border-radius: 50%; filter: blur(120px); pointer-events: none; z-index: 0; }
    .orb-1 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(245,166,35,0.1), transparent 65%); top: -100px; left: -80px; }
    .orb-2 { width: 320px; height: 320px; background: radial-gradient(circle, rgba(37,211,102,0.08), transparent 65%); bottom: -60px; right: -60px; }

    /* ── Card ── */
    .pend-card {
      position: relative; z-index: 1;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2.75rem 2.5rem;
      width: 100%; max-width: 500px;
      text-align: center;
      box-shadow: 0 24px 80px rgba(0,0,0,0.5);
    }

    /* ── Brand ── */
    .pend-brand {
      display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 1.75rem;
    }
    .brand-mark {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, var(--brand), #2C3FA0);
      border-radius: 8px; display: flex; align-items: center; justify-content: center;
      font-size: 15px; color: #fff;
    }
    .brand-type { font-size: 1.1rem; font-weight: 800; }
    .brand-type em { font-style: normal; color: var(--brand); }

    /* ── Icon ── */
    .pend-icon {
      width: 76px; height: 76px; border-radius: 18px;
      background: rgba(245,166,35,0.1);
      border: 1.5px solid rgba(245,166,35,0.3);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 34px; color: var(--amber);
      margin-bottom: 1.5rem;
    }

    /* ── Steps ── */
    .steps {
      display: flex; flex-direction: column; gap: 10px;
      margin: 1.5rem 0 2rem;
      text-align: left;
    }
    .step {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 12px 14px;
      background: rgba(25,43,66,0.45);
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .step-num {
      width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
      background: rgba(79,112,232,0.15); border: 1px solid rgba(79,112,232,0.3);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.72rem; font-weight: 700; color: #93ADFF;
    }
    .step-text strong { display: block; font-size: 0.84rem; font-weight: 600; margin-bottom: 2px; }
    .step-text span   { font-size: 0.77rem; color: var(--text-sec); }
    .step.done .step-num { background: rgba(14,203,129,0.15); border-color: rgba(14,203,129,0.3); color: var(--emerald); }

    /* ── Buttons ── */
    .btn-wa {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 14px 20px;
      background: var(--wa); border: none; border-radius: 10px;
      color: #fff; font-size: 0.95rem; font-weight: 700;
      font-family: 'Inter', sans-serif; cursor: pointer;
      text-decoration: none;
      box-shadow: 0 4px 20px var(--wa-glow);
      transition: transform 0.14s, box-shadow 0.2s;
    }
    .btn-wa:hover { transform: translateY(-2px); box-shadow: 0 8px 28px var(--wa-glow); color: #fff; }
    .btn-wa i { font-size: 22px; }

    .btn-refresh {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 11px 20px; margin-top: 10px;
      background: rgba(79,112,232,0.1); border: 1px solid rgba(79,112,232,0.25);
      border-radius: 10px; color: #93ADFF; font-size: 0.85rem; font-weight: 600;
      font-family: 'Inter', sans-serif; cursor: pointer;
      transition: background 0.15s, transform 0.12s;
    }
    .btn-refresh:hover { background: rgba(79,112,232,0.18); transform: translateY(-1px); }
    .btn-refresh:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-logout {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      width: 100%; padding: 10px 20px; margin-top: 10px;
      background: transparent; border: 1px solid var(--border);
      border-radius: 10px; color: var(--text-muted); font-size: 0.82rem;
      font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none;
      transition: background 0.15s, color 0.15s;
    }
    .btn-logout:hover { background: rgba(25,43,66,0.6); color: var(--text-sec); }

    .status-note {
      font-size: 0.78rem; color: var(--text-muted); margin-top: 0.65rem; min-height: 18px;
    }
    .status-note.ok   { color: var(--emerald); }
    .status-note.fail { color: var(--rose); }

    .spin-ring {
      display: none; width: 15px; height: 15px;
      border: 2px solid rgba(147,173,255,0.3); border-top-color: #93ADFF;
      border-radius: 50%; animation: spin 0.65s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>

  <div class="pend-card" id="pendCard">

    <div class="pend-brand">
      <div class="brand-mark"><i class="bi bi-lightning-charge-fill"></i></div>
      <span class="brand-type">Vault<em>ix</em>POS</span>
    </div>

    <div class="pend-icon" id="pendIcon">
      <i class="bi bi-hourglass-split"></i>
    </div>

    <h1 style="font-size:1.6rem;font-weight:800;letter-spacing:-0.5px;margin-bottom:0.65rem">
      Account Pending <span style="color:var(--amber)">Activation</span>
    </h1>
    <p style="font-size:0.875rem;color:var(--text-sec);line-height:1.75;margin-bottom:0">
      Welcome, <strong style="color:var(--text)"><%= storeName || 'new user' %></strong>! Your store account
      has been created successfully. To begin your trial, contact the developer on WhatsApp —
      activation is usually done within minutes.
    </p>

    <%# Step-by-step instructions %>
    <div class="steps">
      <div class="step done">
        <div class="step-num"><i class="bi bi-check" style="font-size:12px"></i></div>
        <div class="step-text">
          <strong>Account Created</strong>
          <span>Your store profile is ready.</span>
        </div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-text">
          <strong>Contact Developer on WhatsApp</strong>
          <span>Click the button below — it pre-fills your store name.</span>
        </div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-text">
          <strong>Trial Activated</strong>
          <span>The developer activates your account remotely, instantly.</span>
        </div>
      </div>
    </div>

    <%# WhatsApp CTA %>
    <a
      href="https://wa.me/<%= (whatsappNumber || '').replace(/\D/g, '') %>?text=<%= encodeURIComponent('Hello! I just registered on VaultixPOS. My store name is: ' + (storeName || '') + '. Please activate my trial.') %>"
      target="_blank" rel="noopener noreferrer"
      class="btn-wa" id="waBtn"
    >
      <i class="bi bi-whatsapp"></i>
      Contact Developer to Activate Trial
    </a>

    <%# Refresh status %>
    <button type="button" class="btn-refresh" id="refreshBtn">
      <span class="spin-ring" id="rSpin"></span>
      <i class="bi bi-arrow-clockwise" id="rIcon"></i>
      Already activated? Check Status
    </button>
    <p class="status-note" id="statusNote">Click after the developer activates your account.</p>

    <%# Logout %>
    <a href="/logout" class="btn-logout">
      <i class="bi bi-box-arrow-right"></i> Sign out
    </a>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script>
    /* ── Entrance ── */
    gsap.set('#pendCard', { opacity: 0, y: 28 });
    gsap.to('#pendCard',  { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', delay: 0.1 });

    /* ── Icon float ── */
    gsap.to('#pendIcon', { y: -6, duration: 1.4, yoyo: true, repeat: -1, ease: 'sine.inOut' });

    /* ── WA button hover ── */
    const waBtn = document.getElementById('waBtn');
    waBtn.addEventListener('mouseenter', () => gsap.to(waBtn, { scale: 1.02, duration: 0.14 }));
    waBtn.addEventListener('mouseleave', () => gsap.to(waBtn, { scale: 1,    duration: 0.14 }));

    /* ── Refresh Status ── */
    document.getElementById('refreshBtn').addEventListener('click', async function () {
      const btn  = this;
      const note = document.getElementById('statusNote');

      btn.disabled = true;
      document.getElementById('rSpin').style.display = 'inline-block';
      document.getElementById('rIcon').style.display = 'none';
      note.textContent = 'Checking with server…';
      note.className   = 'status-note';

      try {
        const res  = await fetch('/api/check-status', { headers: { 'Accept': 'application/json' }, signal: AbortSignal.timeout(10000) });
        const data = await res.json();

        if (['active', 'trial', 'lifetime'].includes(data.status)) {
          note.textContent = '✓ Activated! Redirecting to your dashboard…';
          note.className   = 'status-note ok';
          gsap.to('#pendCard', {
            opacity: 0, scale: 0.96, duration: 0.35, ease: 'power2.in', delay: 0.6,
            onComplete: () => { window.location.href = '/dashboard'; },
          });
        } else {
          note.textContent = 'Not yet activated. Contact developer and try again.';
          note.className   = 'status-note fail';
          gsap.to('#pendCard', { x: [-5, 5, -4, 4, 0], duration: 0.4, ease: 'none' });
          btn.disabled = false;
        }
      } catch {
        note.textContent = 'Connection error. Please try again.';
        note.className   = 'status-note fail';
        btn.disabled     = false;
      } finally {
        document.getElementById('rSpin').style.display = 'none';
        document.getElementById('rIcon').style.display = '';
      }
    });
  </script>
</body>
</html>
