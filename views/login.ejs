<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — VaultixPOS</title>

  <%# ── CDN Dependencies ── %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ════ Design Tokens ════ */
    :root {
      --brand:        #4F70E8;
      --brand-dark:   #3655C5;
      --brand-glow:   rgba(79, 112, 232, 0.26);
      --emerald:      #0ECB81;
      --rose:         #F43F5E;
      --amber:        #F5A623;
      --bg:           #070E1C;
      --bg-surface:   #0C1625;
      --bg-input:     #0D1827;
      --border:       #192B42;
      --text-primary: #EEF2FF;
      --text-sec:     #8FA3BF;
      --text-muted:   #4A6080;
      --radius:       12px;
      --radius-sm:    8px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      height: 100%;
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* ── Ambient background orbs ── */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(110px);
      pointer-events: none;
      z-index: 0;
    }
    .orb-brand { width: 480px; height: 480px; background: radial-gradient(circle, rgba(79,112,232,0.16), transparent 65%); top: -130px; left: -100px; }
    .orb-amber { width: 320px; height: 320px; background: radial-gradient(circle, rgba(245,166,35,0.1),   transparent 65%); bottom: -80px; right: -80px; }

    /* ── Auth Wrapper ── */
    .auth-wrapper {
      min-height: 100vh;
      display: flex;
      position: relative;
      z-index: 1;
    }

    /* ── Brand Panel ── */
    .brand-panel {
      width: 44%;
      min-height: 100vh;
      background: linear-gradient(160deg, #0B1629 0%, #0E1D34 55%, #08111E 100%);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 2.75rem 3rem;
      position: relative;
      overflow: hidden;
    }
    .brand-panel::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 28% 55%, rgba(79,112,232,0.09) 0%, transparent 60%);
      pointer-events: none;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      z-index: 1;
    }
    .brand-mark {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--brand) 0%, #2C3FA0 100%);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; color: #fff;
      box-shadow: 0 0 18px var(--brand-glow);
      flex-shrink: 0;
    }
    .brand-type {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--text-primary);
    }
    .brand-type em { font-style: normal; color: var(--brand); }

    .brand-hero {
      position: relative;
      z-index: 1;
    }
    .brand-hero h2 {
      font-size: 2.1rem;
      font-weight: 800;
      line-height: 1.22;
      letter-spacing: -0.7px;
      color: var(--text-primary);
      margin-bottom: 1rem;
    }
    .brand-hero h2 .grad {
      background: linear-gradient(90deg, var(--brand) 0%, #9BB4FF 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .brand-hero p {
      font-size: 0.88rem;
      color: var(--text-sec);
      line-height: 1.78;
      max-width: 290px;
    }

    .brand-pills {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .bp {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(79, 112, 232, 0.08);
      border: 1px solid rgba(79, 112, 232, 0.22);
      border-radius: 50px;
      padding: 5px 13px;
      font-size: 0.77rem;
      font-weight: 500;
      color: #93ADFF;
      cursor: default;
      transition: background 0.18s, transform 0.15s;
    }
    .bp i { font-size: 11px; }
    .bp:hover { background: rgba(79,112,232,0.14); }

    /* ── Form Panel ── */
    .form-panel {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 2rem;
    }

    .form-card {
      width: 100%;
      max-width: 395px;
    }
    .form-card h1 {
      font-size: 1.82rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 5px;
    }
    .form-sub {
      font-size: 0.875rem;
      color: var(--text-sec);
      margin-bottom: 2.2rem;
    }
    .form-sub a {
      color: var(--brand);
      text-decoration: none;
      font-weight: 500;
    }
    .form-sub a:hover { text-decoration: underline; }

    /* ── Field ── */
    .field { margin-bottom: 1.1rem; }
    .field label {
      display: block;
      font-size: 0.77rem;
      font-weight: 600;
      color: var(--text-sec);
      text-transform: uppercase;
      letter-spacing: 0.45px;
      margin-bottom: 7px;
    }
    .field-wrap { position: relative; }
    .field-wrap input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 11px 42px 11px 14px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      color: var(--text-primary);
      outline: none;
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    .field-wrap input::placeholder { color: var(--text-muted); }
    .field-wrap input:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px var(--brand-glow);
    }
    .f-icon {
      position: absolute;
      top: 50%; right: 13px;
      transform: translateY(-50%);
      font-size: 15px;
      color: var(--text-muted);
      pointer-events: none;
      transition: color 0.18s;
    }
    .field-wrap input:focus ~ .f-icon { color: var(--brand); }
    .pw-toggle {
      position: absolute;
      top: 50%; right: 11px;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 15px;
      cursor: pointer;
      padding: 4px;
      display: flex;
      align-items: center;
      transition: color 0.18s;
    }
    .pw-toggle:hover { color: var(--text-sec); }
    .pw-toggle:focus-visible { outline: 2px solid var(--brand); border-radius: 4px; }

    /* ── Submit Button ── */
    .btn-submit {
      width: 100%;
      padding: 12px 20px;
      background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      color: #fff;
      cursor: pointer;
      transition: transform 0.14s, box-shadow 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 0.4rem;
      letter-spacing: 0.1px;
    }
    .btn-submit:hover:not(:disabled) {
      box-shadow: 0 6px 22px rgba(79, 112, 232, 0.38);
      transform: translateY(-1px);
    }
    .btn-submit:active:not(:disabled) { transform: scale(0.975); }
    .btn-submit:disabled { opacity: 0.55; cursor: not-allowed; }
    .spin-ring {
      display: none;
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Toast System ── */
    #toastShelf {
      position: fixed;
      bottom: 1.25rem; right: 1.25rem;
      z-index: 9900;
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: min(360px, calc(100vw - 2.5rem));
    }
    .toast-card {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      background: #0F1D30;
      border: 1px solid var(--border);
      box-shadow: 0 12px 40px rgba(0,0,0,0.55);
    }
    .tc-bar {
      position: absolute;
      top: 0; left: 0;
      width: 3px; height: 100%;
      border-radius: 8px 0 0 8px;
    }
    .tc-success .tc-bar { background: var(--emerald); }
    .tc-error   .tc-bar { background: var(--rose);    }
    .tc-info    .tc-bar { background: var(--brand);   }
    .tc-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
    .tc-success .tc-icon { color: var(--emerald); }
    .tc-error   .tc-icon { color: var(--rose);    }
    .tc-info    .tc-icon { color: #93ADFF;         }
    .tc-body { flex: 1; min-width: 0; }
    .tc-title { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); }
    .tc-msg   { font-size: 0.78rem; color: var(--text-sec); margin-top: 2px; line-height: 1.45; }
    .tc-close {
      background: none; border: none;
      color: var(--text-muted); font-size: 13px;
      cursor: pointer; padding: 2px;
      display: flex; align-items: center;
      transition: color 0.15s; flex-shrink: 0;
    }
    .tc-close:hover { color: var(--text-sec); }

    /* ── Responsive ── */
    @media (max-width: 900px) { .brand-panel { display: none !important; } }
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>

  <%# Ambient background blobs %>
  <div class="orb orb-brand" aria-hidden="true"></div>
  <div class="orb orb-amber"  aria-hidden="true"></div>

  <%# Toast notification shelf %>
  <div id="toastShelf" role="log" aria-live="polite" aria-label="Notifications"></div>

  <div class="auth-wrapper">

    <%# ── Brand Panel (Left) ── %>
    <aside class="brand-panel d-none d-lg-flex flex-column" aria-hidden="true">
      <div class="brand-logo">
        <div class="brand-mark"><i class="bi bi-lightning-charge-fill"></i></div>
        <span class="brand-type">Vault<em>ix</em>POS</span>
      </div>

      <div class="brand-hero">
        <h2>Your store,<br /><span class="grad">fully in control.</span></h2>
        <p>A lightweight point-of-sale and inventory platform built for modern retailers who need speed and clarity in every transaction.</p>
      </div>

      <div class="brand-pills">
        <span class="bp"><i class="bi bi-graph-up-arrow"></i> Live revenue tracking</span>
        <span class="bp"><i class="bi bi-boxes"></i>             Inventory alerts</span>
        <span class="bp"><i class="bi bi-receipt"></i>           Instant sale capture</span>
        <span class="bp"><i class="bi bi-building-check"></i>    Multi-store ready</span>
      </div>
    </aside>

    <%# ── Form Panel (Right) ── %>
    <main class="form-panel">
      <div class="form-card" id="loginCard">

        <h1>Welcome back</h1>
        <p class="form-sub">
          Sign in to manage your store &nbsp;·&nbsp;
          <a href="/register">Create account →</a>
        </p>

        <form id="loginForm" novalidate autocomplete="on">

          <%# Email %>
          <div class="field">
            <label for="email">Email address</label>
            <div class="field-wrap">
              <input
                type="email" id="email" name="email"
                placeholder="you@yourstore.com"
                autocomplete="username email" required
              />
              <i class="bi bi-envelope f-icon" aria-hidden="true"></i>
            </div>
          </div>

          <%# Password %>
          <div class="field">
            <label for="password">Password</label>
            <div class="field-wrap">
              <input
                type="password" id="password" name="password"
                placeholder="••••••••"
                autocomplete="current-password" required
              />
              <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password">
                <i class="bi bi-eye" id="pwIcon"></i>
              </button>
            </div>
          </div>

          <%# Submit %>
          <button type="submit" class="btn-submit" id="loginBtn">
            <span class="spin-ring"   id="loginSpinner"></span>
            <span id="loginBtnText">
              <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
              Sign In
            </span>
          </button>

        </form>

      </div><%# /form-card %>
    </main>

  </div><%# /auth-wrapper %>

  <%# ── Scripts ── %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

  <script>
    /* ════════════════════════════════════════
       PAGE ENTRANCE ANIMATION
    ════════════════════════════════════════ */
    gsap.set(['#loginCard', '.brand-logo', '.brand-hero', '.bp'], { opacity: 0 });
    gsap.set('#loginCard',   { y: 28 });
    gsap.set('.brand-hero',  { y: 16 });

    const enterTL = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.1 });
    enterTL
      .to('.brand-logo',  { opacity: 1, duration: 0.5 })
      .to('.brand-hero',  { opacity: 1, y: 0, duration: 0.6 }, '-=0.3')
      .to('.bp',          { opacity: 1, stagger: 0.08, duration: 0.35 }, '-=0.35')
      .to('#loginCard',   { opacity: 1, y: 0, duration: 0.55 }, '-=0.5');

    /* ════════════════════════════════════════
       TOAST SYSTEM
    ════════════════════════════════════════ */
    const TC_CFG = {
      success: { icon: 'bi-check-circle-fill', title: 'Success', cls: 'tc-success' },
      error:   { icon: 'bi-x-circle-fill',     title: 'Error',   cls: 'tc-error'   },
      info:    { icon: 'bi-info-circle-fill',   title: 'Note',    cls: 'tc-info'    },
    };

    function showToast(message, type = 'info') {
      const cfg   = TC_CFG[type] || TC_CFG.info;
      const shelf = document.getElementById('toastShelf');
      const el    = document.createElement('div');

      el.className = `toast-card ${cfg.cls}`;
      el.innerHTML = `
        <span class="tc-bar" aria-hidden="true"></span>
        <i class="bi ${cfg.icon} tc-icon" aria-hidden="true"></i>
        <div class="tc-body">
          <div class="tc-title">${cfg.title}</div>
          <div class="tc-msg">${message}</div>
        </div>
        <button class="tc-close" aria-label="Dismiss">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      `;
      shelf.appendChild(el);

      gsap.fromTo(el,
        { opacity: 0, x: 55, scale: 0.93 },
        { opacity: 1, x: 0,  scale: 1, duration: 0.32, ease: 'back.out(1.6)' }
      );

      const dismiss = () => {
        gsap.to(el, {
          opacity: 0, x: 55, scale: 0.93, duration: 0.22, ease: 'power2.in',
          onComplete: () => el.remove(),
        });
      };
      const timer = setTimeout(dismiss, 4500);
      el.querySelector('.tc-close').addEventListener('click', () => {
        clearTimeout(timer);
        dismiss();
      });
    }

    /* ════════════════════════════════════════
       INPUT MICRO-INTERACTIONS
    ════════════════════════════════════════ */
    document.querySelectorAll('.field-wrap input').forEach(input => {
      input.addEventListener('focus', () => gsap.to(input, { scale: 1.005, duration: 0.12, ease: 'power1.out' }));
      input.addEventListener('blur',  () => gsap.to(input, { scale: 1,     duration: 0.12, ease: 'power1.out' }));
    });

    document.querySelectorAll('.bp').forEach(pill => {
      pill.addEventListener('mouseenter', () => gsap.to(pill, { scale: 1.04, duration: 0.15, ease: 'power2.out' }));
      pill.addEventListener('mouseleave', () => gsap.to(pill, { scale: 1,    duration: 0.15, ease: 'power2.out' }));
    });

    /* ════════════════════════════════════════
       PASSWORD TOGGLE
    ════════════════════════════════════════ */
    document.getElementById('pwToggle').addEventListener('click', function () {
      const input = document.getElementById('password');
      const icon  = document.getElementById('pwIcon');
      const show  = input.type === 'password';
      input.type  = show ? 'text' : 'password';
      icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
      this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });

    /* ════════════════════════════════════════
       SHAKE HELPER
    ════════════════════════════════════════ */
    function shakeCard() {
      gsap.to('#loginCard', {
        keyframes: { x: [0, -9, 9, -7, 7, -4, 4, 0] },
        duration: 0.5, ease: 'none',
      });
    }

    /* ════════════════════════════════════════
       FORM SUBMISSION
    ════════════════════════════════════════ */
    document.getElementById('loginForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const email    = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      if (!email || !password) {
        showToast('Please fill in all fields before continuing.', 'error');
        shakeCard();
        return;
      }

      /* Set loading state */
      const btn     = document.getElementById('loginBtn');
      const spinner = document.getElementById('loginSpinner');
      const btnText = document.getElementById('loginBtnText');

      btn.disabled          = true;
      spinner.style.display = 'block';
      btnText.style.display = 'none';
      gsap.to(btn, { scale: 0.97, duration: 0.1 });

      try {
        const res = await fetch('/login', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify({ email, password }),
          signal:  AbortSignal.timeout(12000),
        });

        let data;
        try {
          data = await res.json();
        } catch {
          throw new Error('The server returned an unexpected response. Please try again.');
        }

        if (res.ok && data.success) {
          showToast(data.message || 'Login successful! Taking you to your dashboard…', 'success');
          gsap.to('#loginCard', {
            opacity: 0, scale: 0.96, y: -10, duration: 0.38, ease: 'power2.in', delay: 0.55,
            onComplete: () => { window.location.href = data.redirect || '/dashboard'; },
          });
        } else {
          showToast(data.message || 'Invalid email or password. Please try again.', 'error');
          shakeCard();
        }

      } catch (err) {
        const msg = err.name === 'TimeoutError'
          ? 'Request timed out. Check your connection and try again.'
          : (err.message || 'Connection error. Please try again.');
        showToast(msg, 'error');
      } finally {
        btn.disabled          = false;
        spinner.style.display = 'none';
        btnText.style.display = '';
        gsap.to(btn, { scale: 1, duration: 0.1 });
      }
    });
  </script>
</body>
</html>
